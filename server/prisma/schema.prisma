generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  password         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  resumeAnalyses   ResumeAnalysis[]
  careerProfile    CareerProfile?
  trajectories     CareerTrajectory[]
}

model ResumeAnalysis {
  id                   Int      @id @default(autoincrement())
  userId               Int
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle             String
  jobDescription       String   @db.Text
  originalResumeText   String   @db.Text
  filename             String
  matchScore           Int
  scoreBreakdown       Json
  matchingSkills       String[]
  missingSkills        String[]
  keyStrengths         String[]
  tailoringSuggestions Json
  tailoredSummary      String   @db.Text
  tailoredBulletPoints Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model CareerProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTitle    String?
  experienceYears Float?
  education       Json      @default("[]")
  skills          Json      @default("[]")
  projects        Json      @default("[]")
  experience      Json      @default("[]")
  interests       String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CareerTrajectory {
  id                 Int                   @id @default(autoincrement())
  userId             Int
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole         String
  targetTimeframe    String
  currentLevel       String
  readinessScore     Int
  readinessBreakdown Json
  skillGaps          Json
  progressionPaths   Json
  status             String                @default("ACTIVE")
  milestones         TrajectoryMilestone[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId])
}

model TrajectoryMilestone {
  id                 Int              @id @default(autoincrement())
  trajectoryId       Int
  trajectory         CareerTrajectory @relation(fields: [trajectoryId], references: [id], onDelete: Cascade)
  order              Int
  phase              String
  title              String
  description        String           @db.Text
  learningObjectives String[]         @default([])
  requiredSkills     String[]         @default([])
  estimatedEffort    String
  practicalProject   Json
  deliverables       String[]         @default([])
  completionCriteria String[]         @default([])
  status             String           @default("NOT_STARTED")
  userNotes          String?          @db.Text
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([trajectoryId])
}
